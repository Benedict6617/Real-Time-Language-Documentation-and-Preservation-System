{
  "expo": {
    "name": "Kaimira Field Recorder",
    "slug": "kaimira-field-recorder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#faf8f4"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kaimira needs microphone access to record language documentation sessions."
      }
    },
    "android": {
      "permissions": ["RECORD_AUDIO"]
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
