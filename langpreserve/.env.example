# ---- General ----
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO

# ---- Database ----
POSTGRES_USER=kaimira
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kaimira
DATABASE_URL=postgresql+asyncpg://kaimira:change-me@db:5432/kaimira

# ---- Object storage (audio/media) ----
STORAGE_BACKEND=s3            # s3 | local
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=kaimira
S3_SECRET_KEY=change-me
S3_BUCKET=kaimira-media
S3_REGION=us-east-1

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- ASR / ML services ----
ASR_PROVIDER=mock             # mock | whisper_local | custom_endpoint
ASR_MODEL_PATH=/models/asr/default
ASR_ENDPOINT_URL=
TTS_PROVIDER=mock             # mock | coqui_local | custom_endpoint

# ---- Archival integration ----
ELAR_API_BASE_URL=https://elar.example-archive.org/api
ELAR_API_KEY=
ELAR_DEFAULT_COLLECTION_ID=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
